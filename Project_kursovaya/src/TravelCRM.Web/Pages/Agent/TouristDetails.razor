@page "/agent/tourist/{Id:int}"
@rendermode RenderMode.InteractiveServer
@inject ITouristService TouristService
@inject ITripService TripService
@inject NavigationManager Nav

<PageTitle>@(_tourist is null ? "Турист" : $"{_tourist.LastName} {_tourist.FirstName}")</PageTitle>

@if (_tourist is null)
{
    <p>Загрузка...</p>
}
else
{
    <div class="bento-container" style="display: block;">
        <a href="/agent/dashboard" class="premium-button secondary inline back-link">← К списку</a>

        <div class="bento-card">
            <div class="row-between">
                <div>
                    <h2>@_tourist.LastName @_tourist.FirstName @_tourist.MiddleName</h2>
                    <p class="text-muted">📞 @_tourist.Phone</p>
                </div>
                <div>
                    <small>EN:</small><br />
                    <strong>@_tourist.EngFirstName @_tourist.EngLastName</strong>
                </div>
            </div>
        </div>

        <div class="docs-grid">
            <div class="bento-card">
                <h4>🛂 Паспорт РФ</h4>
                <small>@(string.IsNullOrEmpty(_tourist.PassportInfo) ? "Не заполнен" : _tourist.PassportInfo)</small>
            </div>
            <div class="bento-card">
                <h4>🌍 Загранпаспорт</h4>
                <small>@(string.IsNullOrEmpty(_tourist.IntPassportInfo) ? "Не заполнен" : _tourist.IntPassportInfo)</small>
            </div>
            <div class="bento-card">
                <h4>🛂 Визы</h4>
                <small>@(string.IsNullOrEmpty(_tourist.VisaInfo) ? "Нет виз" : _tourist.VisaInfo)</small>
            </div>
        </div>

        <div class="bento-card wide">
            <div class="row-between" style="margin-bottom: 16px;">
                <h3>📅 Поездки</h3>
                <a href="/agent/trip/new/@Id" class="premium-button inline">+ Новая поездка</a>
            </div>

            @if (_trips is null || _trips.Count == 0)
            {
                <p class="text-muted">У туриста пока нет поездок.</p>
            }
            else
            {
                <div class="trip-grid">
                    @foreach (var trip in _trips)
                    {
                        <a href="/trip/@trip.Id" class="bento-card trip-card">
                            <h4 class="trip-route">@trip.DepartureCity → @trip.ArrivalCity</h4>
                            <p>📅 @trip.StartDate.ToString("dd.MM.yyyy") – @trip.EndDate.ToString("dd.MM.yyyy")</p>
                            <p>🏨 @trip.HotelName</p>
                            <p>💳 @PaymentLabel(trip.PaymentStatus)</p>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Tourist? _tourist;
    private List<Trip>? _trips;

    protected override async Task OnInitializedAsync()
    {
        _tourist = await TouristService.GetProfileAsync(Id);
        if (_tourist is not null)
        {
            _trips = await TripService.GetForTouristAsync(Id);
        }
    }

    private static string PaymentLabel(PaymentStatus status) => status switch
    {
        PaymentStatus.Unpaid => "Не оплачено",
        PaymentStatus.Pending => "В процессе оплаты",
        PaymentStatus.Paid => "Оплачено",
        _ => "Неизвестно",
    };
}
